# Primary domain Traefik will serve (required)
DOMAIN=zellij.example.com

# Additional domains/IPs to accept, comma-separated (optional)
# Useful for LAN access via IP or alternate hostnames
# EXTRA_DOMAINS=192.168.1.100,fenrir.lan
EXTRA_DOMAINS=

# zellij binary for the web server and token commands (optional, default: zellij on PATH)
# Pin it when the running sessions were started by a different zellij version than
# the one on PATH: the web UI shows sessions of another version as exited.
# ZELLIJ_BIN=~/.local/opt/zellij-0.45.0/zellij
ZELLIJ_BIN=

# Ports published on the host (defaults: 8080, 8443). Rootless podman can't bind
# ports below 1024 unless the host allows it (sysctl net.ipv4.ip_unprivileged_port_start).
# To serve on 80/443, forward them to these ports on your router or firewall, or
# lower that sysctl. See docs/configuration.md#ports.
HTTP_PORT=8080
HTTPS_PORT=8443

# Let's Encrypt: only needed when using the LE cert resolver (docs/tls.md)
ACME_EMAIL=you@example.com

# Telegram alerting (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook URLs, comma-separated (optional)
# WEBHOOK_URLS=https://hooks.example.com/zellij,https://other.example.com/hook
WEBHOOK_URLS=

# Discord webhook URL for native Discord alerts (optional)
DISCORD_WEBHOOK_URL=

# Minimum seconds between alerts for the same IP (default: 60, set 0 to disable)
ALERT_COOLDOWN_SECONDS=60

# Alert when fail2ban bans an IP (default: true). Includes the SSO user if one was signed in.
BAN_ALERTS=true

# Basic auth for the /stats dashboard (optional, but recommended without SSO)
STATS_USERNAME=
STATS_PASSWORD=

# Extra host-loopback ports Traefik must reach from its network namespace, as pasta
# options (zellij 8082, the alerter 8083 and oauth2-proxy are already forwarded).
# E.g. an IdP on 127.0.0.1:9091 for forward-auth: EDGE_PASTA_EXTRA=,-T,9091
EDGE_PASTA_EXTRA=

# Unban button on the /stats dashboard (default: true). Only offered when the page
# has a login: STATS_USERNAME/STATS_PASSWORD above, or SSO.
UNBAN_ENABLED=true

# Optional JSON body template for webhook payloads (docs/alerting.md)
# Fields: event, timestamp, client_ip, x_forwarded_for, user_agent, path, status, service,
# sso_user, sso_email; ban and unban alerts add jail, bantime, failures, unban alerts unbanned_by.
# Rendered with Python str.format: double the JSON braces, single braces for fields.
# Wrap it in single quotes, or just/compose mangle the JSON.
# WEBHOOK_BODY_TEMPLATE='{{"text": "Connection from {client_ip} at {timestamp}"}}'
WEBHOOK_BODY_TEMPLATE=

# Timezone for fail2ban container (default: UTC)
TZ=UTC

# Fail2ban log level: CRITICAL, ERROR, WARNING, NOTICE, INFO, DEBUG (default: INFO)
# F2B_LOG_LEVEL=INFO

# How long fail2ban remembers bans (default: 7d). Repeat offenders get longer bans
# (1h, 2h, 4h ... up to a week) based on this history.
# F2B_DB_PURGE_AGE=7d

# ── SSO (optional) ── see docs/sso.md ─────────────────────────────────────────
# off | oauth2-proxy (any OIDC IdP: Authelia, Keycloak, Authentik)
#     | forward-auth (IdP's own endpoint: Authelia, Authentik)
SSO_MODE=off

# oauth2-proxy mode
# SSO_PROVIDER=oidc                      # or keycloak-oidc
# SSO_PROVIDER_NAME=Authelia
# SSO_OIDC_ISSUER_URL=https://auth.example.com
# SSO_CLIENT_ID=secure-zellij
# SSO_CLIENT_SECRET=
# SSO_COOKIE_SECRET=                     # just sso-cookie-secret
# SSO_OIDC_SCOPE=openid email profile    # Authelia: add "groups"
# SSO_ALLOWED_GROUPS=zellij              # comma-separated, empty = any authenticated user
# SSO_ALLOWED_EMAIL_DOMAINS=*            # e.g. example.com
# SSO_COOKIE_EXPIRE=12h
# SSO_ALLOW_UNVERIFIED_EMAIL=false
# SSO_PROXY_PORT=4180                    # oauth2-proxy listens on 127.0.0.1:<port>

# forward-auth mode
# SSO_FORWARD_AUTH_URL=http://127.0.0.1:9091/api/authz/forward-auth
# SSO_CALLBACK_PREFIX=/outpost.goauthentik.io/   # Authentik only
# SSO_CALLBACK_URL=https://authentik.example.com # Authentik only
